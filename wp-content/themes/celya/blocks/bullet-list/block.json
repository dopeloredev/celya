{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "celya/bullet-list",
  "version": "1.0.0",
  "title": "Celya — Liste à puce",
  "category": "celya",
  "description": "Liste à puces avec icône personnalisable (SVG ou PNG) et espacement réglable. Sans icône, affiche un point classique.",
  "icon": "editor-ul",
  "keywords": ["liste", "puce", "icone", "bullet", "celya"],
  "supports": {
    "html": false,
    "align": false,
    "spacing": {
      "margin": true,
      "padding": true
    },
    "color": {
      "text":       true,
      "background": false,
      "link":       false,
      "gradients":  false
    },
    "typography": {
      "fontSize": true
    }
  },
  "attributes": {
    "items":    { "type": "array",  "default": [{ "id": 1, "text": "Premier élément" }, { "id": 2, "text": "Deuxième élément" }] },
    "iconId":   { "type": "number", "default": 0 },
    "iconUrl":  { "type": "string", "default": "" },
    "iconAlt":  { "type": "string", "default": "" },
    "iconSize": { "type": "number", "default": 20 },
    "gap":      { "type": "number", "default": 12 }
  },
  "editorScript": "celya-bullet-list-editor",
  "style": "celya-bullet-list-style",
  "render": "file:./render.php"
}
