{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "celya/realisations",
  "version": "1.0.0",
  "title": "Celya — Réalisations",
  "category": "celya",
  "description": "Galerie de réalisations filtrables par occasion.",
  "icon": "screenoptions",
  "keywords": ["realisations", "galerie", "portfolio", "celya"],
  "supports": {
    "html": false,
    "align": false,
    "spacing": { "margin": true, "padding": true }
  },
  "attributes": {
    "occasions":           { "type": "array",   "items": { "type": "string" }, "default": [] },
    "limit":               { "type": "number",  "default": 8 },
    "showFilters":         { "type": "boolean", "default": true },
    "pillInactiveBorder":  { "type": "string",  "default": "#59332A" },
    "pillInactiveBg":      { "type": "string",  "default": ""        },
    "pillInactiveText":    { "type": "string",  "default": "#59332A" },
    "pillActiveBorder":    { "type": "string",  "default": "#59332A" },
    "pillActiveBg":        { "type": "string",  "default": "#59332A" },
    "pillActiveText":      { "type": "string",  "default": "#ffffff" },
    "columns":             { "type": "number",  "default": 4 },
    "imageSize":           { "type": "string",  "default": "celya-product-thumb" },
    "imageRatio":          { "type": "string",  "default": "square"  }
  },
  "editorScript": "celya-realisations-editor",
  "viewScript":   "celya-realisations-view",
  "style":        "celya-realisations-style",
  "render":       "file:./render.php"
}
